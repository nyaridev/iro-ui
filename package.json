{
  "name": "iro-ui",
  "version": "0.0.0",
  "description": "React components with swappable styles (BlomboUI, forge) and a Design Lab.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lab": "vite --config lab/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check:size": "node scripts/check-size.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:size"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}

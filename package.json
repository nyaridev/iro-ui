{
  "name": "iro-ui",
  "version": "1.2.0",
  "description": "React components with swappable styles (kami, sumi and kon) and a Design Lab.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/types/icons/index.d.ts",
      "default": "./dist/icons.js"
    },
    "./effects": {
      "types": "./dist/types/effects/index.d.ts",
      "default": "./dist/effects.js"
    },
    "./styles/*.css": "./src/styles/*/index.css",
    "./tailwind.css": "./src/tailwind.css"
  },
  "scripts": {
    "lab": "vite --config lab/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:visual": "playwright test --project=visual",
    "check:ui": "playwright test --project=ui",
    "check:ui:browsers": "playwright test --project=ui-firefox --project=ui-webkit",
    "check:size": "node scripts/check-size.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:size && pnpm check:css",
    "check:css": "node scripts/check-css.ts"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "web-features": "^3.45.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0"
  }
}
